  "components": {
    "schemas": {
      "ApiKeyCreateRequest": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 120,
            "minLength": 3,
            "title": "Name"
          },
          "permissions": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 20,
            "minItems": 1,
            "title": "Permissions"
          },
          "expires_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expires At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "permissions"
        ],
        "title": "ApiKeyCreateRequest"
      },
      "CaseActionRequest": {
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "approve",
              "decline_recommendation",
              "escalate",
              "request_information",
              "temporarily_hold",
              "duplicate"
            ],
            "title": "Action"
          },
          "reason_code": {
            "type": "string",
            "pattern": "^[A-Z0-9_:-]{3,80}$",
            "title": "Reason Code"
          },
          "note": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2000
              },
              {
                "type": "null"
              }
            ],
            "title": "Note"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "action",
          "reason_code"
        ],
        "title": "CaseActionRequest"
      },
      "DecisionReason": {
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "model_threshold",
              "rule",
              "degraded_mode"
            ],
            "title": "Type"
          },
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "type",
          "code",
          "message"
        ],
        "title": "DecisionReason"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "degraded"
            ],
            "title": "Status"
          },
          "checks": {
            "additionalProperties": {
              "type": "boolean"
            },
            "type": "object",
            "title": "Checks"
          }
        },
        "type": "object",
        "required": [
          "status",
          "checks"
        ],
        "title": "HealthResponse"
      },
      "OutcomeRequest": {
        "properties": {
          "transaction_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._:-]{4,120}$",
            "title": "Transaction Id"
          },
          "confirmed_fraud": {
            "type": "boolean",
            "title": "Confirmed Fraud"
          },
          "source": {
            "type": "string",
            "maxLength": 80,
            "minLength": 3,
            "title": "Source",
            "default": "analyst_review"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "transaction_id",
          "confirmed_fraud"
        ],
        "title": "OutcomeRequest"
      },
      "ScoreResponse": {
        "properties": {
          "transaction_id": {
            "type": "string",
            "title": "Transaction Id"
          },
          "decision_id": {
            "type": "string",
            "title": "Decision Id"
          },
          "idempotent_replay": {
            "type": "boolean",
            "title": "Idempotent Replay",
            "default": false
          },
          "risk_probability": {
            "type": "number",
            "title": "Risk Probability"
          },
          "decision": {
            "type": "string",
            "enum": [
              "ALLOW",
              "REVIEW",
              "BLOCK"
            ],
            "title": "Decision"
          },
          "policy_version": {
            "type": "string",
            "title": "Policy Version"
          },
          "model_version": {
            "type": "string",
            "title": "Model Version"
          },
          "feature_version": {
            "type": "string",
            "title": "Feature Version"
          },
          "latency_ms": {
            "type": "number",
            "title": "Latency Ms"
          },
          "thresholds": {
            "additionalProperties": {
              "type": "number"
            },
            "type": "object",
            "title": "Thresholds"
          },
          "velocity_context": {
            "additionalProperties": {
              "type": "number"
            },
            "type": "object",
            "title": "Velocity Context"
          },
          "explanations": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Explanations"
          },
          "decision_reasons": {
            "items": {
              "$ref": "#/components/schemas/DecisionReason"
            },
            "type": "array",
            "title": "Decision Reasons"
          },
          "degraded_mode": {
            "type": "boolean",
            "title": "Degraded Mode",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "transaction_id",
          "decision_id",
          "risk_probability",
          "decision",
          "policy_version",
          "model_version",
          "feature_version",
          "latency_ms",
          "thresholds",
          "velocity_context",
          "explanations",
          "decision_reasons"
        ],
        "title": "ScoreResponse"
      },
      "ThresholdSimulationRequest": {
        "properties": {
          "fraud_loss": {
            "type": "number",
            "maximum": 100000.0,
            "exclusiveMinimum": 0.0,
            "title": "Fraud Loss"
          },
          "false_decline_cost": {
            "type": "number",
            "maximum": 100000.0,
            "minimum": 0.0,
            "title": "False Decline Cost"
          },
          "review_cost": {
            "type": "number",
            "maximum": 100000.0,
            "minimum": 0.0,
            "title": "Review Cost"
          },
          "review_capacity_fraction": {
            "type": "number",
            "maximum": 1.0,
            "exclusiveMinimum": 0.0,
            "title": "Review Capacity Fraction"
          }
        },
        "type": "object",
        "required": [
          "fraud_loss",
          "false_decline_cost",
          "review_cost",
          "review_capacity_fraction"
        ],
        "title": "ThresholdSimulationRequest"
      },
      "TransactionRequest": {
        "properties": {
          "transaction_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._:-]{4,120}$",
            "title": "Transaction Id"
          },
          "program_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._:-]{2,80}$",
            "title": "Program Id",
            "default": "default"
          },
          "customer_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._:-]{2,80}$",
            "title": "Customer Id"
          },
          "card_id": {
