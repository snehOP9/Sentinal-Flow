# Required for Docker Compose. Do not use these values outside local development.
DATABASE_URL=postgresql+asyncpg://sentinel:sentinel_local_only@postgres:5432/sentinelflow
REDIS_URL=redis://redis:6379/0
MLFLOW_TRACKING_URI=http://mlflow:5000
MODEL_PATH=/app/artifacts/production/model_bundle.joblib
CORS_ALLOWED_ORIGINS=http://localhost:3000
DEMO_AUTH_ENABLED=true
AUTH_MODE=demo
ENVIRONMENT=development
# Local/test convenience only. Compose and non-development deploys use Alembic.
SCHEMA_MANAGEMENT=create_all
EXPECTED_SCHEMA_REVISION=0002_operations_foundation
DEMO_ORGANIZATION_ID=org_demo
# OIDC values are required together when AUTH_MODE=oidc outside local demo mode.
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
DEMO_SEED=20260830
RATE_LIMIT_PER_MINUTE=120
REQUEST_MAX_BYTES=65536
LOG_LEVEL=INFO
SENTRY_DSN=
